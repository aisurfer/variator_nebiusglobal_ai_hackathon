{
 "schema": "variator-intake/1",
 "title": "What decision are you weighing",
 "subtitle": "Ask in your own words: VARIATOR asks a few short questions, then drafts the forks of a new case.",
 "placeholder": "For example: what if we lose our biggest client?",
 "examples": [
  "What if we raise prices by 8% in January?",
  "What if we lose our biggest client?",
  "What if we outsource delivery to a vendor?",
  "What if I fire all employees in 3 months?"
 ],
 "maxQuestions": 3,
 "slots": {
  "when": [
   {
    "re": "\\bin (\\d+) months?\\b",
    "months": "$1"
   },
   {
    "re": "\\bin (\\d+) weeks?\\b",
    "weeks": "$1"
   },
   {
    "re": "\\bnext month\\b",
    "months": 1
   },
   {
    "re": "\\bnext quarter\\b",
    "months": 3
   },
   {
    "re": "\\b(?:in half a year|in six months)\\b",
    "months": 6
   },
   {
    "re": "\\bnext year\\b",
    "monthName": "january"
   },
   {
    "re": "\\b(?:now|today|immediately|right away|at once)\\b",
    "months": 0
   },
   {
    "re": "\\b(?:in|from|by|on|at|starting) (january|february|march|april|may|june|july|august|september|october|november|december)\\b",
    "monthName": "$1"
   }
  ],
  "size": [
   {
    "re": "(\\d+(?:\\.\\d+)?)\\s?(?:%|percent|per cent|points?\\b)",
    "share": "$1"
   },
   {
    "re": "\\b(\\d+) (?:more |new |extra )?(?:engineers?|developers?|people|employees|staff|hires?|persons?)\\b",
    "count": "$1"
   }
  ],
  "goal": [
   {
    "re": "\\b(?:cut|save|reduce|lower) (?:our |the )?(?:costs?|money|spend|burn|payroll)\\b|\\bcost cut",
    "value": "cost"
   },
   {
    "re": "\\bwind (?:\\w+ )?down\\b|\\bclose (?:the |our )?(?:company|business)\\b|\\bshut (?:it |us |the company )?down\\b",
    "value": "wind_down"
   },
   {
    "re": "\\brebuild\\b|\\bcontractors?\\b|\\bfreelanc",
    "value": "rebuild"
   },
   {
    "re": "\\bgrow(?:th)?\\b|\\bscale\\b",
    "value": "growth"
   },
   {
    "re": "\\bmargins?\\b|\\bprofit",
    "value": "margin"
   }
  ],
  "compare": [
   {
    "re": "\\b(?:only )?keep(?:ing)? (?:it |things )?as is\\b|\\bstatus quo\\b|\\bnothing else\\b",
    "value": "keep"
   },
   {
    "re": "\\bpartial\\b|\\bsome of\\b|\\bhalf of\\b",
    "value": "partial"
   },
   {
    "re": "\\bvendor\\b|\\boutsourc",
    "value": "vendor"
   }
  ],
  "priority": [
   {
    "re": "\\bcash\\b|\\bmoney\\b|\\brunway\\b",
    "value": "cash"
   },
   {
    "re": "\\bclients?\\b|\\bchurn\\b|\\bcustomers?\\b",
    "value": "churn"
   },
   {
    "re": "\\bdelivery\\b|\\bdeadlines?\\b|\\bon time\\b|\\bsla\\b",
    "value": "delivery"
   },
   {
    "re": "\\bteam\\b|\\bpeople\\b|\\bmorale\\b",
    "value": "team"
   },
   {
    "re": "\\bmargins?\\b|\\bprofit",
    "value": "margin"
   }
  ]
 },
 "criteria": {
  "cash": "Cash at the horizon",
  "churn": "Client churn",
  "sla": "Availability (SLA)",
  "delivery": "Delivery on time",
  "team": "Team capacity",
  "margin": "Margin"
 },
 "goalText": {
  "cost": ", to cut costs",
  "wind_down": ", to wind the company down",
  "rebuild": ", to rebuild the team with contractors",
  "growth": ", to grow",
  "margin": ", to raise the margin",
  "retain": ", to keep people from leaving"
 },
 "intents": [
  {
   "id": "layoff",
   "area": "people",
   "label": "Cut the team",
   "patterns": [
    "\\bfir(?:e|ing)\\b",
    "\\blay ?offs?\\b|\\blaid off\\b",
    "\\blet (?:\\w+ ){0,4}go\\b",
    "\\bdismiss",
    "\\bredundan",
    "\\bcut (?:the |our )?(?:team|staff|headcount|jobs)\\b"
   ],
   "scope": [
    {
     "re": "\\b(?:all|every(?:one|body)|entire|whole)\\b(?! (?:but|except))",
     "value": "all",
     "ambiguous": true
    },
    {
     "re": "\\bexcept (?:the )?(?:leaders|leadership|management)\\b|\\bnon-?leadership\\b",
     "value": "non_leadership"
    },
    {
     "re": "\\bengineer(?:s|ing)?\\b|\\bdevelopers?\\b",
     "value": "dept:engineering"
    },
    {
     "re": "\\bsupport\\b",
     "value": "dept:support"
    },
    {
     "re": "\\bsales\\b",
     "value": "dept:sales"
    },
    {
     "re": "\\bdelivery team\\b",
     "value": "dept:delivery"
    }
   ],
   "scopeText": {
    "all": "all {headcount} people (you included)",
    "non_leadership": "everyone except the leadership ({nonLeadershipCount} people)",
    "dept:engineering": "the engineering team ({dept:engineering} people)",
    "dept:support": "the support team ({dept:support} people)",
    "dept:sales": "the sales team ({dept:sales} people)",
    "dept:delivery": "the delivery team ({dept:delivery} people)"
   },
   "ask": [
    "scope",
    "goal",
    "compare",
    "when"
   ],
   "questions": {
    "scope": {
     "text": "{company} has {headcount} people: {departmentsLine}. The leadership is {leadershipCount} people: {leadershipLine}. Do you mean all {headcount}, including yourself, or everyone except the leadership?",
     "chips": [
      {
       "label": "All {headcount}, including me",
       "value": "all"
      },
      {
       "label": "Everyone except the leadership ({nonLeadershipCount})",
       "value": "non_leadership"
      },
      {
       "label": "Only engineering ({dept:engineering})",
       "value": "dept:engineering"
      }
     ]
    },
    "goal": {
     "text": "What is the goal: cut costs, wind the company down, or rebuild the team with contractors?",
     "chips": [
      {
       "label": "Cut costs",
       "value": "cost"
      },
      {
       "label": "Wind the company down",
       "value": "wind_down"
      },
      {
       "label": "Rebuild with contractors",
       "value": "rebuild"
      }
     ]
    },
    "compare": {
     "text": "Compare it with what? «Keep as is» is always in the case.",
     "chips": [
      {
       "label": "Only keep as is",
       "value": "keep"
      },
      {
       "label": "A partial layoff",
       "value": "partial"
      },
      {
       "label": "Replace delivery with a vendor",
       "value": "vendor"
      }
     ]
    },
    "when": {
     "text": "When would it happen? The notice periods run from that month.",
     "chips": [
      {
       "label": "Right away",
       "value": "months:0"
      },
      {
       "label": "Next month",
       "value": "months:1"
      },
      {
       "label": "Next quarter",
       "value": "months:3"
      },
      {
       "label": "In half a year",
       "value": "months:6"
      }
     ]
    }
   },
   "draft": {
    "question": "What if {company} lets {scope} go{when}{goal}?",
    "forks": [
     "Let {scope} go{when}"
    ],
    "compareForks": {
     "partial": "A partial layoff: only engineering ({dept:engineering} people)",
     "vendor": "Replace delivery with a vendor: {vendor:nearshore} or {vendor:offshore}"
    },
    "hypotheses": [
     "Key accounts give notice when delivery stops",
     "Severance and notice cost more than planned",
     "A vendor cannot take over in time",
     "Sales stall while the team changes"
    ],
    "criteria": [
     "cash",
     "churn",
     "sla",
     "delivery"
    ],
    "shows": [
     "When delivery stops for each client, and which contracts and SLAs are at risk",
     "How churn follows, starting with {keyClient:1} and the other key accounts",
     "Severance, notice and the cash left in each month",
     "The month in which each risk is most likely to fire"
    ]
   }
  },
  {
