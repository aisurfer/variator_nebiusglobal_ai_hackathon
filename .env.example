# Nebius Token Factory (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
# NEBIUS_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Token Factory project id (needed for Sandboxes)
NEBIUS_PROJECT_ID=

# Nebius AI Cloud (Serverless Jobs / Endpoints): IAM access token, project and subnet
NEBIUS_IAM_TOKEN=
NEBIUS_CLOUD_PROJECT_ID=
NEBIUS_SUBNET_ID=

# Tavily (https://tavily.com)
TAVILY_API_KEY=

# Optional model id overrides (check exact ids with GET /v1/models)
# VARIATOR_MODEL_LIGHTNING=nvidia/Nemotron-3_5-Lightning
# VARIATOR_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# VARIATOR_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# VARIATOR_MODEL_SUPER_VL=nvidia/Nemotron-3.5-Super-VL
# VARIATOR_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Structured output mode: json_schema (default) or json_object. The client also
# falls back to json_object automatically if Token Factory rejects json_schema.
# VARIATOR_STRUCTURED_MODE=json_schema

# Tavily cache: reproducible demos without spending credits
# VARIATOR_TAVILY_CACHE_DIR=.cache/tavily
# VARIATOR_TAVILY_CACHE_TTL_S=604800
# VARIATOR_TAVILY_OFFLINE=false

# Token Factory Sandboxes image (see src/variator/sandboxes/README.md)
# VARIATOR_SANDBOX_IMAGE=tag:variator-numpy:py3.12

# Self-hosted cuOpt server (e.g. nvidia/cuopt on a Nebius Serverless Endpoint)
# CUOPT_SERVER_URL=
# CUOPT_SERVER_TOKEN=
