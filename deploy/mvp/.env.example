# VARIATOR MVP stack settings. Copy to deploy/mvp/.env and edit there. Never commit .env.
# Defaults (all values empty or absent): plain HTTP on http://127.0.0.1:8088, no login.

# Public domain. Empty: plain HTTP on localhost. A domain: automatic HTTPS (Let's Encrypt) through caddy.
MVP_DOMAIN=

# Host interface and ports of caddy. Server with a domain: MVP_BIND=0.0.0.0, MVP_HTTP_PORT=80, MVP_HTTPS_PORT=443.
MVP_BIND=127.0.0.1
MVP_HTTP_PORT=8088
MVP_HTTPS_PORT=8443

# One shared login for the whole site (basic auth): off or on.
MVP_AUTH=off
MVP_AUTH_USER=demo
# bcrypt hash: docker compose -f deploy/mvp/compose.yaml run --rm --no-deps caddy caddy hash-password
# Keep the single quotes: the hash contains "$" characters.
MVP_AUTH_HASH=''

# Postgres password of the knowledge base. Set it before the first start: the data volume keeps the first value.
# Use URL-safe characters only (it is part of KB_PG_DSN).
KB_PG_PASSWORD=kb

# 1: the knowledge base never downloads the embedding model (it is baked into the image).
KB_HF_HUB_OFFLINE=1
